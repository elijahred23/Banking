@model CreateFedFundsViewModel
@{ ViewData["Title"] = "Propose overnight federal funds"; }
<h1>Propose overnight trade</h1>
<p>USD, unsecured, fixed annual percentage rate, ACT/360. Maturity is the next eligible business day after the agreed simulated value date. Both banks require a separate maker and approver; no funds move on proposal or approval.</p>
<form method="post" asp-action="Create">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Borrow" class="form-label">Your bank's side</label><select asp-for="Borrow" class="form-select"><option value="true">Borrow / federal funds purchased</option><option value="false">Lend / federal funds sold</option></select></div>
<div class="mb-3"><label asp-for="CounterpartyBankId" class="form-label">Counterparty</label><select asp-for="CounterpartyBankId" asp-items="Model.Banks" class="form-select"></select></div>
<div class="mb-3"><label asp-for="Principal" class="form-label">Principal USD</label><input asp-for="Principal" type="number" step="0.0001" class="form-control" /></div>
<div class="mb-3"><label asp-for="AnnualRate" class="form-label">Negotiated annual rate (%)</label><input asp-for="AnnualRate" type="number" step="0.00000001" min="0" max="100" class="form-control" required /></div>
<div class="mb-3"><label asp-for="ValueDate" class="form-label">Value date</label><input asp-for="ValueDate" class="form-control" /></div>
<button class="btn btn-primary" type="submit">Propose terms</button>
</form>
