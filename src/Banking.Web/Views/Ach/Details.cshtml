@model AchDetailsViewModel
@{ ViewData["Title"] = "ACH lifecycle"; var entry = Model.Entry; }
<div class="page-heading mb-3">
    <div><div class="eyebrow">ACH LIFECYCLE · @Model.Bank.Name</div><h1>@entry.Amount.ToString("C") to @entry.ReceiverName</h1><p class="text-secondary mb-0">Entry @entry.Id.ToString()[..8] · @entry.SecCode · @entry.TransactionCode</p></div>
    <span class="badge text-bg-light align-self-start">@entry.Status</span>
</div>
<partial name="_AchNav" />
<partial name="_PaymentAttention" model="PaymentAttentionPolicy.For(entry)" />
@if (entry.OriginatingBankId == Model.Bank.Id && entry.AchBatchId is Guid batchId)
{
    <section class="surface p-3 mb-4 d-flex flex-wrap align-items-center gap-3">
        @if (Model.File is not null)
        {
            <strong>Attached NACHA file · @Model.File.Status</strong>
            <a class="btn btn-outline-primary" asp-action="Explorer" asp-route-id="@Model.File.Id">Inspect records &amp; fields</a>
            <a asp-action="DownloadNacha" asp-route-id="@Model.File.Id">Download .ach</a>
        }
        else
        {
            <strong>Draft NACHA preview · not submitted</strong>
            <a class="btn btn-outline-primary" asp-action="Explorer" asp-route-batchId="@batchId">Inspect draft records &amp; fields</a>
            <a asp-action="DownloadNacha" asp-route-batchId="@batchId">Download draft .ach</a>
            <span class="text-secondary small">The saved file is built at the eligible cutoff; previewing changes no payment state.</span>
        }
    </section>
}


@if (entry.OriginatingBankId != Model.Bank.Id)
{
    <p class="text-secondary small">Full NACHA files and draft previews belong to the originating bank. Switch to that bank's lab context to inspect its file; this view shows your bank's entry lifecycle.</p>
}

@if (entry.Status == AchEntryStatus.PendingApproval)
{
    <section class="surface p-4 mb-4">
        <div class="eyebrow">DUAL CONTROL</div><h2 class="h5">Independent release required</h2>
        <p class="text-secondary">Created by <strong>@(entry.CreatedBy ?? "legacy workflow")</strong>. No hold, batch, file, or value movement exists yet.</p>
        @if (User.IsInRole(BankSecurity.PaymentApprover) && (User.HasAllPermissions() || !string.Equals(entry.CreatedBy, User.Identity?.Name, StringComparison.OrdinalIgnoreCase)))
        {
            @if (!Model.Exposure.WithinLimit) { <div class="alert alert-danger">Projected teaching exposure @Model.Exposure.Proposed.ToString("C") exceeds the @Model.Exposure.Limit.ToString("C") limit. Approval may still be followed by ODFI rejection.</div> }
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="DecideApproval" method="post"><input type="hidden" name="id" value="@entry.Id" /><input type="hidden" name="approve" value="true" /><button class="btn btn-primary">Approve and release</button></form>
                <form asp-action="DecideApproval" method="post" class="d-flex gap-2 flex-grow-1"><input type="hidden" name="id" value="@entry.Id" /><input type="hidden" name="approve" value="false" /><input class="form-control" name="reason" maxlength="500" placeholder="Rejection reason" /><button class="btn btn-outline-danger">Reject</button></form>
            </div>
        }
        else { <div class="alert alert-warning mb-0">Sign in as a different approver to release or reject this entry.</div> }
    </section>
}

<section class="surface p-4 mb-4">
    <div class="d-flex justify-content-between flex-wrap gap-2"><div><div class="eyebrow">EXPOSURE</div><h2 class="h5">ODFI credit exposure</h2></div><strong>@Model.Exposure.Proposed.ToString("C") / @Model.Exposure.Limit.ToString("C")</strong></div>
    <div class="progress mb-2" role="progressbar"><div class="progress-bar" style="width:@Math.Min(100, Model.Exposure.Limit == 0 ? 100 : Model.Exposure.Proposed / Model.Exposure.Limit * 100)%"></div></div>
    <p class="form-text mb-0">Approval, ODFI validation, and exposure acceptance are separate decisions.</p>
</section>

<section class="surface p-4 mb-4">
    <div class="eyebrow">STATE EVIDENCE</div><h2 class="h4">Who acted, what changed, and whether value moved</h2>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Stage</th><th>Actor</th><th>Evidence</th><th>Value effect</th><th>Observed</th></tr></thead><tbody>
    @foreach (var step in Model.Lifecycle) { <tr class="@(step.Complete ? "" : "text-secondary")"><td><strong>@step.Stage</strong></td><td>@step.Actor</td><td>@step.Evidence</td><td>@step.ValueEffect</td><td>@(step.OccurredDate?.ToLocalTime().ToString("g") ?? "Not yet")</td></tr> }
    </tbody></table></div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-5"><section class="surface p-4 h-100"><div class="eyebrow">BALANCES</div><h2 class="h5">Observed account state</h2>
        @foreach (var balance in Model.Balances) { <div class="border-top py-3"><strong>@balance.Name</strong><div>Ledger @balance.Ledger.ToString("C") · held @balance.Held.ToString("C") · available @balance.Available.ToString("C")</div></div> }
        <p class="form-text">These are current durable balances. Use the journal below to reconstruct value changes.</p>
    </section></div>
    <div class="col-lg-7"><section class="surface p-4 h-100"><div class="eyebrow">OPERATIONS DEBRIEF</div><h2 class="h5">@Model.Decision.Layer</h2><p><strong>@Model.Decision.Action</strong></p><p>@Model.Decision.Explanation</p><span class="badge text-bg-light">@(Model.Decision.MovesValue ? "Value-affecting action" : "No value movement")</span></section></div>
</div>

<section class="surface p-4 mb-4"><div class="eyebrow">ACCOUNTING PROOF</div><h2 class="h4">Correlated journal reconstruction</h2>
@if (Model.Journal.Count == 0) { <div class="alert alert-secondary">No value journal is present. This is expected before final acceptance and may be expected after rejection.</div> }
else { <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Journal</th><th>Account</th><th>Description</th><th>Debit</th><th>Credit</th></tr></thead><tbody>
@foreach (var line in Model.Journal) { <tr><td><code>@line.JournalId.ToString()[..8]</code></td><td>@line.AccountName<br><code>@line.AccountCode</code></td><td>@line.Description</td><td>@(line.Debit == 0 ? "—" : line.Debit.ToString("C"))</td><td>@(line.Credit == 0 ? "—" : line.Credit.ToString("C"))</td></tr> }
<tr class="fw-bold"><td colspan="3">Proof</td><td>@Model.Journal.Sum(x => x.Debit).ToString("C")</td><td>@Model.Journal.Sum(x => x.Credit).ToString("C")</td></tr>
</tbody></table></div> }
</section>
