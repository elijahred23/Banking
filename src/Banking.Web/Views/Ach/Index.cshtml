@model AchIndexViewModel
@{ ViewData["Title"] = "ACH entries"; }
<div class="page-heading mb-3">
    <div><div class="eyebrow">@Model.Bank.Name</div><h1>ACH entries</h1><p class="text-secondary mb-0">Batch-oriented FedACH/NACHA learning flow.</p></div>
    @if (User.IsInRole(BankSecurity.PaymentCreator)) { <a class="btn btn-primary" asp-action="Create">Create ACH entry</a> }
    else { <span class="btn btn-primary disabled" aria-disabled="true">Create entry · Maker only</span> }
</div>
<partial name="_AchNav" />
<div class="surface table-responsive payment-table-shell"><table class="table align-middle mb-0 responsive-payment-table" role="table">
    <caption class="visually-hidden">ACH entries for the active bank</caption>
    <thead><tr><th>Created</th><th>Company / receiver</th><th>SEC</th><th>Type</th><th>Amount</th><th>Effective</th><th>Status</th><th>Trace / return</th></tr></thead>
    <tbody>
    @foreach (var entry in Model.Entries) {
        <tr><td data-label="Created">@entry.CreatedDate.ToLocalTime().ToString("g")</td><td data-label="Company / receiver"><a asp-action="Details" asp-route-id="@entry.Id"><strong>@entry.CompanyName</strong></a><br><span class="text-secondary">@entry.ReceiverName · @entry.ReceivingRoutingNumber / @entry.ReceivingAccountNumber</span></td><td data-label="SEC">@entry.SecCode</td><td data-label="Type">@entry.TransactionCode</td><td data-label="Amount" class="fw-semibold">@entry.Amount.ToString("C")</td><td data-label="Effective">@entry.EffectiveEntryDate</td><td data-label="Status"><span class="badge text-bg-light">@entry.Status</span></td><td data-label="Trace / return"><code>@(entry.TraceNumber ?? "—")</code><br><span class="text-danger">@entry.ReturnCode</span></td></tr>
    }
    @if (Model.Entries.Count == 0) { <tr><td colspan="8" class="text-secondary py-4 text-center">No ACH entries for this bank.</td></tr> }
    </tbody>
</table></div>
