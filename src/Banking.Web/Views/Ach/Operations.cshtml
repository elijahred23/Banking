@model AchOperationsViewModel
@{ ViewData["Title"] = "ACH operations lab"; string[] layers = ["Bank authorization", "ODFI validation", "Operator file validation", "RDFI notification of change", "RDFI return", "Settlement/accounting"]; }
<div class="mb-3"><div class="eyebrow">@Model.Bank.Name · BLIND DIAGNOSIS</div><h1>ACH operations workbench</h1><p class="text-secondary">Classify the observed evidence before revealing the injected teaching condition.</p></div>
<partial name="_AchNav" />
@foreach (var item in Model.Cases)
{
    <article class="surface p-4 mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@item.Entry.Id.ToString()[..8] · @item.Entry.Amount.ToString("C")</strong><p class="mb-2">@item.Evidence</p><a asp-action="Details" asp-route-id="@item.Entry.Id">Inspect lifecycle evidence</a></div><span class="badge text-bg-light align-self-start">@item.Entry.Status</span></div>
    @if (item.Correct is null) { <form asp-action="Operations" method="get" class="row align-items-end mt-3"><input type="hidden" name="answeredId" value="@item.Entry.Id" /><div class="col-lg-8"><label class="form-label">Which layer should operations classify?</label><select name="decision" class="form-select">@foreach (var layer in layers) { <option>@layer</option> }</select></div><div class="col-lg-4 mt-2"><button class="btn btn-outline-primary">Check decision</button></div></form> }
    else { <div class="alert @(item.Correct == true ? "alert-success" : "alert-warning") mt-3"><strong>@(item.Correct == true ? "Correct classification." : "Reclassify this evidence.")</strong> Expected layer: @item.Expected.Layer. @item.Expected.Explanation <span class="badge text-bg-light">@(item.Expected.MovesValue ? "Value reverses or posts" : "No value movement")</span></div> }
    <form asp-action="Replay" method="post" class="mt-3"><input type="hidden" name="id" value="@item.Entry.Id" /><button class="btn btn-sm btn-outline-secondary">Queue duplicate validation delivery</button><span class="form-text ms-2">Then verify state and journal counts do not change.</span></form>
    </article>
}
@if (Model.Cases.Count == 0) { <div class="surface p-4 text-secondary">No exception evidence exists yet. Create a blind ACH exercise as a maker, release it as an approver, then return here as operations.</div> }
