@model CreateAchViewModel
@{
    ViewData["Title"] = "Create ACH entry";
    AchValuePickerViewModel Picker(string field) => new(field, Model.Choices[field]);
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="mb-4"><div class="eyebrow">ACH ENTRY</div><h1>Create ACH credit or debit</h1><p class="text-secondary">Use <strong>Show values</strong> beside any field to see accepted choices and database-backed examples. Selecting a receiver or company fills its related fields together.</p></div>
<form method="post" class="surface form-surface">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <div class="field-label-row"><label asp-for="OriginatingAccountId" class="form-label">Originating account</label><partial name="_ValuePicker" model="Picker(nameof(Model.OriginatingAccountId))" /></div>
    <select asp-for="OriginatingAccountId" asp-items="Model.Accounts" class="form-select"><option value="">Select an account</option></select><span asp-validation-for="OriginatingAccountId" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="CompanyName" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.CompanyName))" /></div><input asp-for="CompanyName" class="form-control"><span asp-validation-for="CompanyName" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="CompanyId" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.CompanyId))" /></div><input asp-for="CompanyId" class="form-control"><span asp-validation-for="CompanyId" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-4 mb-3"><div class="field-label-row"><label asp-for="Purpose" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.Purpose))" /></div><select asp-for="Purpose" asp-items="Html.GetEnumSelectList<AchPaymentPurpose>()" class="form-select"></select><span asp-validation-for="Purpose" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><div class="field-label-row"><label asp-for="SecCode" class="form-label">SEC code</label><partial name="_ValuePicker" model="Picker(nameof(Model.SecCode))" /></div><select asp-for="SecCode" asp-items="Html.GetEnumSelectList<AchStandardEntryClass>()" class="form-select"></select><span asp-validation-for="SecCode" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><div class="field-label-row"><label asp-for="TransactionCode" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.TransactionCode))" /></div><select asp-for="TransactionCode" asp-items="Html.GetEnumSelectList<AchTransactionCode>()" class="form-select"></select><span asp-validation-for="TransactionCode" class="text-danger"></span></div>
</div>
<div class="mb-3"><div class="field-label-row"><label asp-for="ReceiverName" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.ReceiverName))" /></div><input asp-for="ReceiverName" class="form-control"><span asp-validation-for="ReceiverName" class="text-danger"></span></div>
<div class="row">
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="ReceivingRoutingNumber" class="form-label">Receiver ABA routing number</label><partial name="_ValuePicker" model="Picker(nameof(Model.ReceivingRoutingNumber))" /></div><input asp-for="ReceivingRoutingNumber" class="form-control" inputmode="numeric"><span asp-validation-for="ReceivingRoutingNumber" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="ReceivingAccountNumber" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.ReceivingAccountNumber))" /></div><input asp-for="ReceivingAccountNumber" class="form-control"><span asp-validation-for="ReceivingAccountNumber" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="Amount" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.Amount))" /></div><div class="input-group"><span class="input-group-text">$</span><input asp-for="Amount" class="form-control"></div><span asp-validation-for="Amount" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="EffectiveEntryDate" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.EffectiveEntryDate))" /></div><input asp-for="EffectiveEntryDate" class="form-control"><span asp-validation-for="EffectiveEntryDate" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="EntryDescription" class="form-label"></label><partial name="_ValuePicker" model="Picker(nameof(Model.EntryDescription))" /></div><input asp-for="EntryDescription" class="form-control"><span asp-validation-for="EntryDescription" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><div class="field-label-row"><label asp-for="Scenario" class="form-label">Learning scenario</label><partial name="_ValuePicker" model="Picker(nameof(Model.Scenario))" /></div><select asp-for="Scenario" asp-items="Html.GetEnumSelectList<AchProcessingScenario>()" class="form-select"></select></div>
</div>
<div class="mb-4"><div class="field-label-row"><label asp-for="Addenda05" class="form-label">Addenda 05 (optional)</label><partial name="_ValuePicker" model="Picker(nameof(Model.Addenda05))" /></div><textarea asp-for="Addenda05" class="form-control" rows="2"></textarea><span asp-validation-for="Addenda05" class="text-danger"></span></div>
<div class="form-actions"><button class="btn btn-primary">Queue ACH entry</button><a class="btn btn-light" asp-action="Index">Cancel</a></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
