@model IReadOnlyList<DiagnosticChallengeViewModel>
@{ ViewData["Title"] = "Exception decisions"; }
<div class="page-heading mb-4"><div><div class="eyebrow">BRANCHING OPERATIONS PRACTICE</div><h1>Choose the next authorized action</h1><p class="text-secondary mb-0">Preserve the observed payment state. A retry, repair, return, or escalation has a different meaning.</p></div><a asp-action="Index">Learning Center</a></div>
<div class="challenge-grid">@foreach(var item in Model){<article class="surface challenge-card"><span>DECISION CASE</span><h2 class="h5">@item.Title</h2><p>@item.Evidence</p><form asp-action="DecideBranch" method="post"><input type="hidden" name="id" value="@item.Id"/><fieldset><legend class="h6">Next action</legend>@foreach(var choice in item.Suspects){<label class="d-block mb-2"><input type="radio" name="answer" value="@choice" required/> @choice</label>}</fieldset><button class="btn btn-outline-primary btn-sm">Commit decision</button></form><details class="mt-3"><summary>Review consequence</summary><strong>@item.Diagnosis</strong><p>@item.Verification</p></details></article>}</div>
<aside class="production-callout mt-4"><strong>Authorization boundary</strong><span>These cases teach state reasoning. Production repair, return, and escalation rights depend on formal procedures and rail rules outside this lab.</span></aside>
