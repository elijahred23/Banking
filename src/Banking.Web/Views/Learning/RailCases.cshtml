@model IReadOnlyList<RailDecisionCaseViewModel>
@{ ViewData["Title"] = "Rail decision cases"; }
<div class="page-heading mb-4"><div><div class="eyebrow">DECISION PRACTICE</div><h1>Choose from requirements</h1><p class="text-secondary mb-0">Urgency, geography, amount, return rights, data, and settlement determine the rail.</p></div><a asp-action="Rails">Comparison table</a></div>
<div class="challenge-grid">@foreach(var item in Model){<article class="surface challenge-card"><span>CASE @item.Id.ToUpperInvariant()</span><h2 class="h5">@item.Requirement</h2><form asp-action="DecideRail" method="post"><input type="hidden" name="id" value="@item.Id"/><fieldset><legend class="h6">Recommended rail</legend>@foreach(var choice in item.Choices){<label class="d-block mb-2"><input type="radio" name="answer" value="@choice" required/> @choice</label>}</fieldset><label class="form-label" for="confidence-@item.Id">Confidence</label><input id="confidence-@item.Id" class="form-range" type="range" name="confidence" min="1" max="5" value="3"/><button class="btn btn-outline-primary btn-sm">Submit choice</button></form><details class="mt-3"><summary>Reveal recommendation</summary><h3 class="h6">@item.Answer</h3><p>@item.Explanation</p></details></article>}</div>
<aside class="production-callout mt-4"><strong>Decision scope</strong><span>Real institutions also apply operating rules, customer agreements, risk limits, availability, pricing, sanctions controls, and service cutoffs not fully modeled here.</span></aside>
