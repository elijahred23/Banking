@model IsoExplorerViewModel
@{ ViewData["Title"] = "ISO 20022 Explorer"; }
<div class="page-heading mb-4"><div><div class="eyebrow">MESSAGE LAB</div><h1>ISO 20022 explorer</h1><p class="text-secondary mb-0">Select a live message, then inspect its populated leaf fields and their meaning.</p></div><a asp-action="Index">Learning Center</a></div>

<section class="surface mission-section mb-4">
    <div class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label" for="explorer-message">Recent message</label><select id="explorer-message" class="form-select"><option value="">Choose a message</option>@foreach (var item in Model.Messages) { <option value="@item.Id">@item.Type · @item.Direction · @item.CreatedDate.ToLocalTime().ToString("g")</option> }</select></div><div class="col-lg-4"><span class="section-help">@Model.Messages.Count recent messages available</span></div></div>
    @if (!Model.Messages.Any()) { <div class="alert alert-info mt-3 mb-0">Create and approve a wire to populate the explorer with live ISO messages.</div> }
    <div id="iso-learning-output" class="iso-learning-output mt-4"><p class="text-secondary mb-0">Choose a message to begin.</p></div>
    @foreach (var item in Model.Messages) { <script type="application/xml" id="iso-data-@item.Id">@Html.Raw(item.Xml.Replace("</script", "&lt;/script", StringComparison.OrdinalIgnoreCase))</script> }
</section>

<section class="surface mission-section mb-4"><div class="eyebrow">FIELD GLOSSARY</div><h2 class="h4">High-value correlation and settlement fields</h2><div class="field-definition-grid">@foreach (var field in Model.Fields) { <article><code>@field.Element</code><strong>@field.Name</strong><span>@field.Meaning</span></article> }</div></section>
<section class="surface mission-section"><div class="eyebrow">MESSAGE COMPARISON</div><h2 class="h4">Instruction, status, return, and investigation</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Message</th><th>Purpose</th><th>Sent by</th><th>Typical response</th><th>Moves value?</th></tr></thead><tbody>@foreach (var item in Model.MessageTypes) { <tr><th><code>@item.Type</code></th><td>@item.Purpose</td><td>@item.SentBy</td><td><code>@item.TypicalResponse</code></td><td>@item.ValueMovement</td></tr> }</tbody></table></div></section>

@section Scripts { <script src="~/js/learning.js" asp-append-version="true"></script> }
