@model InstructorDashboardViewModel
@{ ViewData["Title"] = "Instructor dashboard"; }
<div class="page-heading mb-4"><div><div class="eyebrow">INSTRUCTOR MODE</div><h1>Learner progress</h1><p class="text-secondary mb-0">Assign missions and review completion and assessment evidence.</p></div><div class="page-actions"><a class="btn btn-outline-primary" asp-action="ExportResults">Export CSV</a><a asp-action="Index">Learning Center</a></div></div>
<section class="surface mission-section mb-4"><div class="eyebrow">ASSIGNMENTS</div><h2 class="h4">Mission links and expected outcomes</h2><div class="assignment-grid">@foreach(var mission in Model.Missions){<article><strong>@mission.Title</strong><span>@mission.Objectives.First()</span><a asp-action="Mission" asp-route-id="@mission.Id">Open assignment</a></article>}</div></section>
<div class="table-responsive surface mb-4"><table class="table mb-0"><thead><tr><th>Bank</th><th>Started</th><th>Completed</th><th>Knowledge checks</th><th>Last activity</th></tr></thead><tbody>@foreach(var bank in Model.Banks){<tr><th>@bank.Bank</th><td>@bank.Started</td><td>@bank.Completed</td><td>@bank.Correct / @bank.Answered correct</td><td>@bank.LastActivity?.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>
<section class="surface mission-section"><h2 class="h4">Recent attempts</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bank</th><th>Mission</th><th>Question</th><th>Result</th><th>Time</th></tr></thead><tbody>@foreach(var item in Model.RecentAttempts){<tr><td>@item.Bank.Name</td><td>@item.MissionId</td><td>@item.QuestionId</td><td>@(item.IsCorrect ? "Correct" : "Incorrect")</td><td>@item.CreatedDate.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div></section>
