@model InstructorDashboardViewModel
@{ ViewData["Title"] = "Instructor dashboard"; }
<div class="page-heading mb-4"><div><div class="eyebrow">INSTRUCTOR MODE</div><h1>Learner progress</h1><p class="text-secondary mb-0">Assign missions and review completion and assessment evidence.</p></div><div class="page-actions"><a class="btn btn-outline-primary" asp-action="ExportResults">Export CSV</a><a asp-action="Index">Learning Center</a></div></div>
<section class="surface mission-section mb-4"><div class="eyebrow">ASSIGNMENTS</div><h2 class="h4">Assign evidence-based work</h2><form asp-action="Assign" method="post" class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label" for="missionId">Mission</label><select class="form-select" id="missionId" name="missionId">@foreach(var mission in Model.Missions){<option value="@mission.Id">@mission.Title</option>}</select></div><div class="col-md-3"><label class="form-label" for="cohort">Cohort</label><input class="form-control" id="cohort" name="cohort" maxlength="80" required /></div><div class="col-md-2"><label class="form-label" for="dueDate">Due</label><input class="form-control" id="dueDate" name="dueDate" type="date" /></div><div class="col-md-2"><button class="btn btn-primary" type="submit">Assign</button></div></form>
@if(Model.Assignments.Count > 0){<div class="table-responsive mt-4"><table class="table"><thead><tr><th>Bank</th><th>Cohort</th><th>Mission</th><th>Due</th></tr></thead><tbody>@foreach(var item in Model.Assignments){<tr><td>@item.Bank.Name</td><td>@item.Cohort</td><td>@item.MissionId</td><td>@item.DueDate?.ToLocalTime().ToString("d")</td></tr>}</tbody></table></div>}</section>
<div class="table-responsive surface mb-4"><table class="table mb-0"><thead><tr><th>Bank</th><th>Started</th><th>Completed</th><th>Knowledge checks</th><th>Last activity</th></tr></thead><tbody>@foreach(var bank in Model.Banks){<tr><th>@bank.Bank</th><td>@bank.Started</td><td>@bank.Completed</td><td>@bank.Correct / @bank.Answered correct</td><td>@bank.LastActivity?.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>
<section class="surface mission-section mb-4"><h2 class="h4">Evidence runs</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bank</th><th>Learner/cohort</th><th>Mission</th><th>Item</th><th>Evidence</th><th>Started</th></tr></thead><tbody>@foreach(var item in Model.RecentRuns){<tr><td>@item.Bank.Name</td><td>@item.LearnerAlias</td><td>@item.MissionId</td><td>@item.ItemType @item.ItemId?.ToString()[..8]</td><td>@item.EvidenceScore% · @item.Status</td><td>@item.StartedDate.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div></section>
<section class="surface mission-section"><h2 class="h4">Recent attempts and misconceptions</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bank</th><th>Learner</th><th>Mission</th><th>Selected answer</th><th>Confidence</th><th>Result</th><th>Time</th></tr></thead><tbody>@foreach(var item in Model.RecentAttempts){<tr><td>@item.Bank.Name</td><td>@item.LearnerAlias</td><td>@item.MissionId</td><td>@item.SelectedAnswer</td><td>@item.Confidence / 5</td><td>@(item.IsCorrect ? "Correct" : "Incorrect")</td><td>@item.CreatedDate.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div></section>
