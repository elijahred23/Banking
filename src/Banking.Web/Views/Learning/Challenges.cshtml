@model IReadOnlyList<DiagnosticChallengeViewModel>
@{ ViewData["Title"] = "Diagnostic challenges"; }
<div class="page-heading mb-4"><div><div class="eyebrow">OPERATIONS PRACTICE</div><h1>Diagnostic challenges</h1><p class="text-secondary mb-0">Form a diagnosis before revealing the answer.</p></div><a asp-action="Index">Learning Center</a></div>
<div class="challenge-grid">@foreach (var item in Model) { <article class="surface challenge-card"><span>Bank-scoped live evidence</span><h2 class="h4">@item.Title</h2><p>@item.Evidence</p><form asp-action="Diagnose" method="post"><input type="hidden" name="id" value="@item.Id" /><fieldset><legend class="h6">Choose the best-supported diagnosis</legend>@foreach(var suspect in item.Suspects){<label class="d-block mb-2"><input type="radio" name="answer" value="@suspect" required /> @suspect</label>}</fieldset><button class="btn btn-outline-primary btn-sm">Submit diagnosis</button></form><details class="mt-3"><summary>Reveal after attempting</summary><h3 class="h6">@item.Diagnosis</h3><p>@item.Verification</p></details>@if(item.ItemId is not null && item.ItemType == "Wire"){<a asp-controller="Wires" asp-action="Details" asp-route-id="@item.ItemId">Inspect correlated wire</a>}</article> }</div>
