@{ ViewData["Title"] = "Payment glossary"; var terms = new[] { ("Finality","The point at which settlement is irrevocable under the applicable rail rules."),("UETR","Unique end-to-end transaction reference used to track an ISO 20022 payment."),("pacs.008","Customer credit transfer instruction between financial institutions."),("pacs.002","Payment-processing status report; it communicates state but does not itself move value."),("Hold","A reduction in available balance before a debit is finally posted."),("Settlement","Discharge of the interbank obligation through the relevant account arrangement."),("ODFI","Originating Depository Financial Institution in ACH."),("RDFI","Receiving Depository Financial Institution in ACH."),("IMAD / OMAD","Fedwire input and output message accountability identifiers."),("Correspondent banking","An arrangement in which one bank provides payment or account services to another.") }; }
<div class="page-heading mb-4"><div><div class="eyebrow">REFERENCE</div><h1>Payment glossary</h1><p class="text-secondary mb-0">Definitions used throughout the lab.</p></div><a asp-action="Index">Learning Center</a></div><div class="glossary-grid">@foreach(var term in terms){<article class="surface"><h2 class="h5">@term.Item1</h2><p>@term.Item2</p></article>}</div>
