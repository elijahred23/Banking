@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var links = new List<(string Group, string Label, string Controller, string Action, string Icon)>
    {
        ("Workspace", "Overview", "Home", "Index", "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z")
    };
    if (User.IsInRole(BankSecurity.Operations))
    {
        links.Add(("Workspace", "Payment desk", "PaymentDesk", "Index", "M3 5h18v14H3z M3 10h18 M8 15h3"));
        links.Add(("Workspace", "Operations", "Operations", "Index", "M3 12h4l3-8 4 16 3-8h4"));
    }
    links.AddRange(new[] {
        ("Payments", "Wires", "Wires", "Index", "M4 7h16m-5-5 5 5-5 5 M20 17H4m5-5-5 5 5 5"),
        ("Payments", "ACH entries", "Ach", "Index", "M4 4h16v16H4z M8 8h8 M8 12h8 M8 16h4"),
        ("Payments", "Checks", "Check", "Index", "M3 6h18v12H3z M7 10h5 M7 14h9")
    });
    if (User.IsInRole(BankSecurity.Operations))
    {
        links.Add(("Simulation", "Wire studio", "Simulator", "Index", "M4 19V9 M10 19V4 M16 19v-7 M22 19H2"));
        links.Add(("Simulation", "ACH studio", "AchSimulator", "Index", "M3 21V9l6-4v16 M9 21V3h6v18 M15 21V9h6v12 M1 21h22"));
    }
    links.Add(("Simulation", "Campaigns", "StudioCampaigns", "Index", "M4 3v19 M4 4h14l-3 5 3 5H4"));
    links.AddRange(new[] {
        ("Resources", "Learning center", "Learning", "Index", "M2 4h8l2 2 2-2h8v15h-8l-2 2-2-2H2z M12 6v15"),
        ("Resources", "Payment guides", "Wires", "Instructions", "M5 3h11l3 3v15H5z M9 10h6 M9 14h6 M9 18h4"),
        ("Resources", "Message workflows", "Wires", "MessageWorkflows", "M3 4h18v13H8l-5 4z M7 8h10 M7 12h6"),
        ("Resources", "Glossary", "Learning", "Glossary", "M4 3h16v18H4z M8 3v18 M12 8h4 M12 12h4")
    });
}
<nav class="workspace-nav" aria-label="Primary navigation">
@foreach (var group in links.GroupBy(x => x.Group))
{
    <div class="workspace-nav-group"><span class="workspace-nav-heading">@group.Key</span>
    @foreach (var link in group)
    {
        var selected = controller == link.Controller && (link.Action == "Index"
            ? (link.Controller == "Wires" ? action is not ("Instructions" or "MessageWorkflows")
                : link.Controller == "Learning" ? action != "Glossary" : true)
            : action == link.Action);
        <a class="workspace-nav-link @(selected ? "is-current" : "")" asp-controller="@link.Controller" asp-action="@link.Action" aria-current="@(selected ? "page" : null)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@link.Icon" /></svg><span>@link.Label</span>
            @if (selected) { <span class="workspace-nav-marker" aria-hidden="true"></span> }
        </a>
    }
    </div>
}
</nav>
