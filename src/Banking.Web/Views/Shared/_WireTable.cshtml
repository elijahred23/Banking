@model IEnumerable<WireTransfer>
<div class="table-responsive surface payment-table-shell">
<table class="table align-middle mb-0 responsive-payment-table wire-activity-table" role="table">
    <caption class="visually-hidden">Wire payment activity for the active bank</caption>
    <thead><tr><th>Created</th><th>Rail / message</th><th>Direction</th><th>Parties</th><th>Status</th><th class="text-end">Amount</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
    @foreach (var wire in Model)
    {
        <tr>
            <td data-label="Created"><span class="text-nowrap">@wire.CreatedDate.ToLocalTime().ToString("MMM d, HH:mm")</span><br><code>@wire.Id.ToString()[..8]</code></td>
            <td data-label="Rail">@wire.Rail<br><code>@(wire.TransferType == WireTransferType.FinancialInstitutionCreditTransfer ? "pacs.009" : "pacs.008")</code></td>
            <td data-label="Direction"><span class="direction @wire.Direction.ToString().ToLowerInvariant()">@wire.Direction</span></td>
            <td data-label="Parties"><strong>@wire.SenderName</strong><br><span class="text-secondary">to @wire.ReceiverName</span></td>
            <td data-label="Status"><span class="status status-@wire.Status.ToString().ToLowerInvariant()">@wire.Status</span></td>
            <td data-label="Amount" class="text-end fw-semibold">@wire.Amount.ToString("C")</td>
            <td data-label="Details" class="text-end payment-row-action"><a asp-controller="Wires" asp-action="Details" asp-route-id="@wire.Id">Details</a></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="empty">No payments for this bank yet.</td></tr> }
    </tbody>
</table>
</div>
