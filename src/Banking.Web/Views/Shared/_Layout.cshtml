@inject IDbContextFactory<BankingDbContext> DbFactory
@{
    var activeBankName = User.FindFirst("bank_name")?.Value;
    var activeBankId = User.Identity?.IsAuthenticated == true ? User.BankId() : Guid.Empty;
    var hasAllPermissions = User.IsInRole(BankSecurity.PaymentCreator)
        && User.IsInRole(BankSecurity.PaymentApprover)
        && User.IsInRole(BankSecurity.ComplianceOfficer)
        && User.IsInRole(BankSecurity.Operations);
    var activeRoleKey = hasAllPermissions ? "all"
        : User.IsInRole(BankSecurity.PaymentCreator) ? "maker"
        : User.IsInRole(BankSecurity.PaymentApprover) ? "approver"
        : User.IsInRole(BankSecurity.ComplianceOfficer) ? "compliance"
        : "operations";
    var activeRoleLabel = activeRoleKey == "all" ? "All permissions"
        : char.ToUpperInvariant(activeRoleKey[0]) + activeRoleKey[1..];
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var banks = new List<Bank>();
    if (User.Identity?.IsAuthenticated == true)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        banks = await db.Banks.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bank Payments Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "workspace-authenticated" : "workspace-public")">
<a class="skip-link" href="#main-content">Skip to main content</a>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="workspace-sidebar">
        <a class="workspace-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span><span>Bank Payments<span class="workspace-brand-subtitle">THE SIMULATION LAB</span></span></a>
        <partial name="_AppNavigation" />
        <div class="workspace-sidebar-note"><span class="workspace-lab-dot" aria-hidden="true"></span><div><strong>Learning environment</strong><small>Simulated funds. Real understanding.</small></div></div>
    </aside>
    <div class="offcanvas offcanvas-start workspace-mobile-nav" tabindex="-1" id="workspace-menu" aria-labelledby="workspace-menu-title">
        <div class="offcanvas-header"><h2 class="h5 mb-0" id="workspace-menu-title">Bank Payments Lab</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button></div>
        <div class="offcanvas-body"><partial name="_AppNavigation" /></div>
    </div>
}
<header class="workspace-topbar">
    <div class="workspace-page-context">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="workspace-menu-toggle btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#workspace-menu" aria-controls="workspace-menu" aria-label="Open navigation"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
            <span class="workspace-breadcrumb">Workspace <span aria-hidden="true">/</span> <strong>@ViewData["Title"]</strong></span>
        }
        else
        {
            <a class="workspace-login-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span> Bank Payments Lab</a>
        }
    </div>
    <div class="workspace-header-actions"><span class="workspace-environment"><span aria-hidden="true"></span> Simulation</span>
    @if (User.Identity?.IsAuthenticated == true)
    {
<div class="dropdown context-switcher">
                    <button class="btn btn-sm dropdown-toggle context-switcher-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Switch bank or user. Currently @activeRoleLabel at @activeBankName">
                        <span class="context-switcher-label">@activeBankName</span>
                        <span class="context-switcher-role">@activeRoleLabel</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end context-switcher-menu">
                        <form asp-controller="Auth" asp-action="Switch" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <fieldset>
                                <legend class="h6 mb-1">Switch bank or user</legend>
                                <p class="text-secondary small mb-3">Change your simulated lab context without leaving this page.</p>
                                <div class="mb-3">
                                    <label class="form-label" for="context-bank">Bank</label>
                                    <select class="form-select form-select-sm" id="context-bank" name="bankId">
                                        @foreach (var bank in banks)
                                        {
                                            <option value="@bank.Id" selected="@(bank.Id == activeBankId)">@bank.Name · @bank.RoutingNumber</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="context-role">User</label>
                                    <select class="form-select form-select-sm" id="context-role" name="role">
                                        <option value="all" selected="@(activeRoleKey == "all")">All permissions — access every lab workflow</option>
                                        <option value="maker" selected="@(activeRoleKey == "maker")">Maker — creates payments</option>
                                        <option value="approver" selected="@(activeRoleKey == "approver")">Approver — approves payments</option>
                                        <option value="compliance" selected="@(activeRoleKey == "compliance")">Compliance — reviews screening</option>
                                        <option value="operations" selected="@(activeRoleKey == "operations")">Operations — monitors processing</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary btn-sm w-100" type="submit">Switch context</button>
                            </fieldset>
                        </form>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button class="dropdown-item text-center" type="submit">Sign out</button>
                        </form>
                    </div>
                </div>
    }
    </div>
</header>
<main id="main-content" class="app-main workspace-content" tabindex="-1">
    @if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="app-footer workspace-footer"><span>Bank Payments Lab</span><span>Learning simulator · All balances and messages are simulated.</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
