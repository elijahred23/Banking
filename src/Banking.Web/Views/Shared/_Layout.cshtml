@inject IDbContextFactory<BankingDbContext> DbFactory
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var activeBankName = User.FindFirst("bank_name")?.Value;
    var activeBankId = User.Identity?.IsAuthenticated == true ? User.BankId() : Guid.Empty;
    var hasAllPermissions = User.IsInRole(BankSecurity.PaymentCreator)
        && User.IsInRole(BankSecurity.PaymentApprover)
        && User.IsInRole(BankSecurity.ComplianceOfficer)
        && User.IsInRole(BankSecurity.Operations);
    var activeRoleKey = hasAllPermissions ? "all"
        : User.IsInRole(BankSecurity.PaymentCreator) ? "maker"
        : User.IsInRole(BankSecurity.PaymentApprover) ? "approver"
        : User.IsInRole(BankSecurity.ComplianceOfficer) ? "compliance"
        : "operations";
    var activeRoleLabel = activeRoleKey == "all" ? "All permissions"
        : char.ToUpperInvariant(activeRoleKey[0]) + activeRoleKey[1..];
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var banks = new List<Bank>();
    if (User.Identity?.IsAuthenticated == true)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        banks = await db.Banks.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bank Payments Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="topbar">
    <nav class="navbar navbar-expand-xl navbar-dark container py-3" aria-label="Primary navigation">
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span> Bank Payments Lab</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle primary navigation"><span class="navbar-toggler-icon"></span></button>
            <div id="nav" class="collapse navbar-collapse">
                <ul class="navbar-nav ms-xl-4 me-auto">
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Overview</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Operations" ? "active" : "")" asp-controller="Operations" asp-action="Index">Operations</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Learning" ? "active" : "")" asp-controller="Learning" asp-action="Index">Learn</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Wires" && currentAction == "Index" && !Context.Request.Query.ContainsKey("direction") ? "active" : "")" asp-controller="Wires" asp-action="Index">All wires</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Wires" && Context.Request.Query["direction"] == "Outgoing" ? "active" : "")" asp-controller="Wires" asp-action="Index" asp-route-direction="Outgoing">Outgoing</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Wires" && Context.Request.Query["direction"] == "Incoming" ? "active" : "")" asp-controller="Wires" asp-action="Index" asp-route-direction="Incoming">Incoming</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(currentAction is "Instructions" or "MessageWorkflows" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">How to create</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Wires" asp-action="Instructions">Wires</a></li>
                            <li><a class="dropdown-item" asp-controller="Wires" asp-action="MessageWorkflows">Non-value messages</a></li>
                            <li><a class="dropdown-item" asp-controller="Ach" asp-action="Instructions">ACH</a></li>
                            <li><a class="dropdown-item" asp-controller="Check" asp-action="Instructions">Checks</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Ach" && currentAction != "Instructions" ? "active" : "")" asp-controller="Ach" asp-action="Index">ACH</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Check" && currentAction != "Instructions" ? "active" : "")" asp-controller="Check" asp-action="Index">Checks</a></li>
                </ul>
                <a class="btn btn-sm btn-outline-light me-2" asp-controller="Learning" asp-action="Glossary">Glossary</a>
            </div>
                <div class="dropup context-switcher">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle context-switcher-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Switch bank or user. Currently @activeRoleLabel at @activeBankName">
                        <span class="context-switcher-label">@activeBankName</span>
                        <span class="context-switcher-role">@activeRoleLabel</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end context-switcher-menu">
                        <form asp-controller="Auth" asp-action="Switch" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <fieldset>
                                <legend class="h6 mb-1">Switch bank or user</legend>
                                <p class="text-secondary small mb-3">Change your simulated lab context without leaving this page.</p>
                                <div class="mb-3">
                                    <label class="form-label" for="context-bank">Bank</label>
                                    <select class="form-select form-select-sm" id="context-bank" name="bankId">
                                        @foreach (var bank in banks)
                                        {
                                            <option value="@bank.Id" selected="@(bank.Id == activeBankId)">@bank.Name · @bank.RoutingNumber</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="context-role">User</label>
                                    <select class="form-select form-select-sm" id="context-role" name="role">
                                        <option value="all" selected="@(activeRoleKey == "all")">All permissions — access every lab workflow</option>
                                        <option value="maker" selected="@(activeRoleKey == "maker")">Maker — creates payments</option>
                                        <option value="approver" selected="@(activeRoleKey == "approver")">Approver — approves payments</option>
                                        <option value="compliance" selected="@(activeRoleKey == "compliance")">Compliance — reviews screening</option>
                                        <option value="operations" selected="@(activeRoleKey == "operations")">Operations — monitors processing</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary btn-sm w-100" type="submit">Switch context</button>
                            </fieldset>
                        </form>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button class="dropdown-item text-center" type="submit">Sign out</button>
                        </form>
                    </div>
                </div>
        }
    </nav>
</header>
<main id="main-content" class="container app-main py-4 py-lg-5" tabindex="-1">
    @if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="container app-footer py-4 text-secondary small border-top">Fedwire, FedNow, SWIFT CBPR+, ACH, and check processing learning environment · All balances and messages are simulated.</footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
