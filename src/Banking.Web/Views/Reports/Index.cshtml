@model ReportLibraryViewModel
@{ ViewData["Title"] = "Tasks & reports"; }
<header class="page-heading mb-4"><div><span class="eyebrow">AUTOMATION & INSIGHT · @Model.Bank.Name</span><h1>Tasks &amp; reports</h1><p class="text-secondary mb-0">Schedule a check. Run it now. Keep the evidence.</p></div><a class="btn btn-primary" asp-action="Task">＋ Create report task</a></header>
<section class="surface report-bank-bar mb-4">
    <div><strong>@Model.Bank.Name</strong><small>Schedules and saved reports belong to this bank.</small></div>
    <form asp-controller="Auth" asp-action="Switch" method="post"><input type="hidden" name="role" value="@(User.HasAllPermissions() ? "all" : "operations")" /><input type="hidden" name="returnUrl" value="@Url.Action("Index", "Reports")" /><label class="visually-hidden" for="report-bank">Report bank</label><select class="form-select" name="bankId" id="report-bank">@foreach (var bank in Model.Banks) { <option value="@bank.Id" selected="@(bank.Id == Model.Bank.Id)">@bank.Name</option> }</select><button class="btn btn-outline-primary" type="submit">View bank</button></form>
</section>
<div class="report-template-grid mb-4">
@foreach (var kind in Enum.GetValues<BankReportKind>())
{
    var description = kind switch { BankReportKind.PaymentActivity => "ACH and wire volume, amounts, recorded states, and payment evidence.", BankReportKind.Reconciliation => "Journal balance, missing postings, held funds, and transport controls.", BankReportKind.Liquidity => "Bank cash, customer ledger balances, available funds, and holds.", _ => "Rejected and returned payments, corrections, and open operations cases." };
    <a asp-action="Task" asp-route-kind="@kind" class="surface report-template"><span class="eyebrow">REPORT TEMPLATE</span><h2>@ReportSchedulePolicy.Title(kind)</h2><p>@description</p><span>Create task →</span></a>
}
</div>
<section class="surface report-panel mb-4">
    <div class="panel-heading"><div><span class="eyebrow">BANK AUTOMATION</span><h2 class="h4 mb-0">Scheduled tasks</h2></div><span class="small text-secondary">@Model.Tasks.Count task(s)</span></div>
    <p class="small text-secondary">Schedules use UTC wall time and run while Banking.Web is running. Paused schedules still support Run now. After downtime, one current report replaces missed intervals. Reporting never moves funds or advances the shared lab clock.</p>
    @if (Model.Tasks.Count == 0) { <div class="desk-empty">Create a task from a template above. Start paused, run it manually, then enable a schedule when ready.</div> }
    @foreach (var task in Model.Tasks)
    {
        <article class="report-task-row"><div><strong>@task.Name</strong><small>@ReportSchedulePolicy.Title(task.Kind) · rolling @task.LookbackHours hours</small><small>@ReportSchedulePolicy.Cadence(task.Frequency, task.DailyAtUtc)</small></div><div><span class="status @(task.Enabled ? "status-settled" : "")">@(task.Enabled ? "Scheduled" : "Paused")</span><small>@(task.Enabled ? $"Next {task.NextRunAt:MMM dd, HH:mm} UTC" : "Manual runs available")</small></div><div class="report-task-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Task" asp-route-id="@task.Id">Edit schedule</a><form asp-action="RunNow" method="post"><input type="hidden" name="id" value="@task.Id" /><button class="btn btn-sm btn-primary">Run now →</button></form></div></article>
    }
</section>
<section class="surface report-panel">
    <div class="panel-heading"><div><span class="eyebrow">SAVED EVIDENCE</span><h2 class="h4 mb-0">Report library</h2></div><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Refresh</a></div>
    <form method="get" class="report-filter mb-4"><div><label for="report-kind" class="form-label">Report type</label><select id="report-kind" name="kind" class="form-select"><option value="">All report types</option>@foreach (var kind in Enum.GetValues<BankReportKind>()) { <option value="@kind" selected="@(Model.Kind == kind)">@ReportSchedulePolicy.Title(kind)</option> }</select></div><div><label for="report-from" class="form-label">Requested from (UTC)</label><input id="report-from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" required /></div><div><label for="report-to" class="form-label">Through (UTC)</label><input id="report-to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" required /></div><button class="btn btn-outline-primary">Filter reports</button></form>
    <p class="small text-secondary">@Model.Total run(s) match · page @Model.Page · saved reports retain their captured values when payments later change.</p>
    @if (Model.Runs.Count == 0) { <div class="desk-empty">No runs match this bank and date range. Run a task above or adjust the filters.</div> }
    @foreach (var run in Model.Runs)
    {
        <a asp-action="Details" asp-route-id="@run.Id" class="report-run-row"><div><strong>@run.TaskName</strong><small>@ReportSchedulePolicy.Title(run.Kind) · @(run.ScheduledFor is null ? "Manual" : "Scheduled") · @run.RequestedBy</small></div><div><span class="status @(run.Status == ReportRunStatus.Succeeded ? "status-settled" : run.Status == ReportRunStatus.Failed ? "status-rejected" : "status-pendingapproval")">@run.Status</span><small>@run.RequestedAt.ToString("MMM dd, yyyy HH:mm 'UTC'")</small></div><span aria-hidden="true">→</span></a>
    }
    <nav class="d-flex gap-2 mt-3" aria-label="Report pages">@if (Model.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-kind="@Model.Kind" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Previous</a> } @if (Model.Page * 25 < Model.Total) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-kind="@Model.Kind" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Next</a> }</nav>
</section>
