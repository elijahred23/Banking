@model SavedReportViewModel
@{ ViewData["Title"] = Model.Run.TaskName; }
<header class="page-heading mb-4"><div><span class="eyebrow">SAVED BANK REPORT · @Model.BankName</span><h1>@Model.Run.TaskName</h1><p class="text-secondary mb-0">@ReportSchedulePolicy.Title(Model.Run.Kind) · @Model.Run.RequestedAt.ToString("MMM dd, yyyy HH:mm 'UTC'")</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Report library</a>@if (Model.Report is not null) { <a asp-action="Download" asp-route-id="@Model.Run.Id" class="btn btn-primary">Download JSON</a> }</div></header>
<section class="surface report-panel mb-4"><div class="report-run-meta"><span class="status @(Model.Run.Status == ReportRunStatus.Succeeded ? "status-settled" : Model.Run.Status == ReportRunStatus.Failed ? "status-rejected" : "status-pendingapproval")">@Model.Run.Status</span><span>@(Model.Run.ScheduledFor is null ? "Manual run" : $"Scheduled for {Model.Run.ScheduledFor:u}")</span><span>Requested by @Model.Run.RequestedBy</span><span>@Model.Run.Attempts attempt(s)</span></div><code>Run @Model.Run.Id</code>
@if (Model.Run.CompletedAt is null)
{
    <div class="report-pending mt-3" data-report-status-url="@Url.Action("Status", new { id = Model.Run.Id })"><strong>Report work is @(Model.Run.Status == ReportRunStatus.Queued ? "queued" : "running").</strong><p>The web report worker checks durable requests every five seconds. This page refreshes when the run completes. Closing the page does not cancel the run.</p><p class="small mb-0" data-report-progress role="status">Checking run status…</p></div>
}
@if (Model.Run.Error is not null) { <div class="alert alert-danger mt-3" role="alert">@Model.Run.Error</div> }
@if (Model.Run.CompletedAt is not null) { <p class="small text-secondary mt-2 mb-0">Completed @Model.Run.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</p> }
<form asp-action="RunNow" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Run.TaskId" /><button class="btn btn-sm btn-outline-primary">@(Model.Run.CompletedAt is null ? "Open active run" : "Run task again")</button><span class="small text-secondary ms-2">A fresh run uses the task's current settings.</span></form>
</section>
@if (Model.Report is { } report)
{
    <div class="report-scope mb-4"><strong>Captured @report.CapturedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</strong><p>@report.Scope</p><small>Activity window: @report.PeriodFrom.ToString("yyyy-MM-dd HH:mm 'UTC'") → @report.PeriodTo.ToString("yyyy-MM-dd HH:mm 'UTC'") · Lab clock: @report.LabTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</small></div>
    <section class="report-metrics mb-4" aria-label="Report totals">@foreach (var metric in report.Metrics) { <article class="surface"><span>@metric.Label</span><strong>@metric.Value</strong><small>@metric.Hint</small></article> }</section>
    @foreach (var reportSection in report.Sections)
    {
        <section class="surface report-panel mb-4"><h2 class="h4">@reportSection.Title</h2><p class="small text-secondary">@reportSection.Description</p>
        @if (reportSection.Rows.Count == 0) { <div class="desk-empty">No matching records were observed for this section.</div> }
        else { <div class="table-responsive"><table class="table responsive-payment-table mb-0" role="table"><caption class="visually-hidden">@reportSection.Title</caption><thead><tr><th>Reference</th><th>Recorded state</th><th>Evidence</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var row in reportSection.Rows) { <tr><td data-label="Reference">@if (row.ItemId is Guid id && row.Controller is "Ach" or "Wires") { <a asp-controller="@row.Controller" asp-action="Details" asp-route-id="@id">@row.Reference</a> } else { @row.Reference }</td><td data-label="Recorded state">@row.Status</td><td data-label="Evidence">@row.Detail</td><td data-label="Amount" class="text-end">@(row.Amount?.ToString("C") ?? "—")</td></tr> }</tbody></table></div> }
        </section>
    }
}
@section Scripts { <script src="~/js/bank-reports.js" asp-append-version="true"></script> }
