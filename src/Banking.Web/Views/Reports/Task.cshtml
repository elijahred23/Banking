@model ReportTaskForm
@{ ViewData["Title"] = Model.Id is null ? "Create task" : "Edit task"; }
<div class="page-heading mb-4"><div><span class="eyebrow">BANK JOB AUTOMATION</span><h1>@ViewData["Title"]</h1><p class="text-secondary mb-0">Choose the evidence to capture and when to capture it.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to reports</a></div>
<div class="report-editor-grid">
<section class="surface report-panel"><form asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Task name</label><input asp-for="Name" class="form-control" maxlength="100" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Kind" class="form-label">Job / report type</label><select asp-for="Kind" class="form-select">@foreach (var kind in Enum.GetValues<BankReportKind>()) { <option value="@kind" data-description="@ReportSchedulePolicy.Description(kind)">@ReportSchedulePolicy.Title(kind)</option> }</select><p class="form-text mt-2" data-job-description>@ReportSchedulePolicy.Description(Enum.IsDefined(Model.Kind) ? Model.Kind : BankReportKind.PaymentActivity)</p></div>
<div class="row g-3 mb-3"><div class="col-sm-6"><label asp-for="Frequency" class="form-label">Schedule</label><select asp-for="Frequency" class="form-select"><option value="Every15Minutes">Every 15 minutes</option><option value="Hourly">Every hour</option><option value="Daily">Daily</option></select></div><div class="col-sm-6"><label asp-for="DailyAtUtc" class="form-label">Daily run time (UTC)</label><input asp-for="DailyAtUtc" type="time" class="form-control" /><div class="form-text">Used only for daily schedules. UTC has no daylight-saving shift.</div></div></div>
<div class="mb-4"><label asp-for="LookbackHours" class="form-label">Activity window (hours)</label><input asp-for="LookbackHours" class="form-control" type="number" min="1" max="744" required /><div class="form-text">1–744 hours. Payment activity and payment exceptions use creation timestamps in this rolling window. Operational checks scan current pending work; duplicate screening uses this window. Controls, balances, and cases reflect capture time.</div></div>
<div class="form-check mb-4"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">Enable scheduled runs</label><div class="form-text">Leave unchecked for manual-only operation. Saving does not immediately run the task.</div></div>
<div class="form-actions"><button class="btn btn-primary" type="submit">Save task</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form></section>
<aside class="surface report-panel align-self-start"><span class="eyebrow">HOW IT WORKS</span><h2 class="h4">A durable record of each run</h2><ol class="instruction-steps"><li><div><strong>Save for the active bank</strong><span>Switch banks in the header or report library to manage another bank's tasks.</span></div></li><li><div><strong>Schedule or run now</strong><span>UTC wall time drives scheduling while the web host runs. Run now queues a durable request.</span></div></li><li><div><strong>Review saved evidence</strong><span>Each run retains its report type, window, requester, status, and captured report. Editing a task preserves old runs.</span></div></li></ol><p class="small text-secondary">One run can be active per task. Interrupted workers retry the same run after its lease expires, up to three claims. A failed run remains visible; Run now creates a fresh attempt. Operational jobs can open cases, escalate overdue severity, validate released ACH instructions, queue eligible NACHA files, or reschedule original delivery retries. They retain approval boundaries and do not correct journals or advance the lab clock.</p></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/bank-reports.js" asp-append-version="true"></script> }
