@model OperationsDashboardViewModel
@{
    ViewData["Title"] = "Operations Dashboard";
    var queueGroups = Model.QueueSnapshot.Queues.GroupBy(x => x.Name.Split('.')[0]);
}

<div class="operations-heading mb-4">
    <div>
        <div class="eyebrow">PAYMENT OPERATIONS CENTER</div>
        <h1 class="mb-1">Operations dashboard</h1>
        <div class="text-secondary">@Model.Bank.Name · live rail, settlement, journal, and exception visibility</div>
    </div>
    <div class="operations-refresh">
        <span class="live-dot @(Model.QueueSnapshot.BrokerAvailable ? "is-live" : "")"></span>
        <span>Updated <time id="dashboard-updated" datetime="@Model.RefreshedDate.ToString("O")">just now</time></span>
        <button id="refresh-dashboard" type="button" class="btn btn-sm btn-outline-secondary">Refresh</button>
    </div>
</div>

<p><a class="btn btn-primary" asp-controller="PaymentDesk" asp-action="Index">Open payment desk · blockers, clock &amp; reconciliation →</a></p>
<div class="row g-4 mt-1">
    <section class="col-lg-5" aria-labelledby="clock-heading">
        <div class="surface operations-panel h-100">
            <div class="eyebrow">SIMULATION TIME</div><h2 id="clock-heading" class="h4">Operating clock</h2>
            <p><strong>@Model.Simulation.CurrentUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</strong></p>
            <p class="form-text">A deterministic teaching clock controls dated exercises. It does not represent a production rail clock.</p>
            <form asp-action="AdvanceClock" method="post" class="d-flex gap-2">
                <label class="visually-hidden" for="advance-hours">Hours</label>
                <select id="advance-hours" name="hours" class="form-select">
                    <option value="1">1 hour</option><option value="8">8 hours</option>
                    <option value="24">1 day</option><option value="72">3 days</option>
                </select>
                <button class="btn btn-outline-primary" type="submit">Advance</button>
            </form>
        </div>
    </section>
    <section class="col-lg-7" aria-labelledby="availability-heading">
        <div class="surface operations-panel h-100">
            <div class="eyebrow">CUSTOMER FUNDS</div><h2 id="availability-heading" class="h4">Ledger, collected, and available</h2>
            <div class="table-responsive"><table class="table operations-table mb-0">
                <thead><tr><th>Account</th><th class="text-end">Ledger</th><th class="text-end">Collected</th><th class="text-end">Available</th><th class="text-end">Holds</th></tr></thead>
                <tbody>@foreach (var account in Model.AccountAvailability) { <tr>
                    <td><strong>@account.Customer</strong><code>@account.AccountNumber · @account.Status</code></td>
                    <td class="text-end">@account.Ledger.ToString("C")</td><td class="text-end">@account.Collected.ToString("C")</td>
                    <td class="text-end">@account.Available.ToString("C")</td><td class="text-end">@account.Holds.ToString("C")</td>
                </tr> }</tbody>
            </table></div>
        </div>
    </section>
</div>

<section class="surface operations-panel mt-4" aria-labelledby="cases-heading">
    <div class="panel-heading"><div><div class="eyebrow">CASE MANAGEMENT</div><h2 id="cases-heading" class="h4 mb-0">Investigation work queue</h2></div><span class="text-secondary small">Ownership, SLA, evidence, and closure</span></div>
    @if (Model.Cases.Count == 0) { <div class="operations-empty">No cases. Open one from an exception below or use the fault lab.</div> }
    else { <div class="table-responsive"><table class="table operations-table mb-0"><thead><tr><th>Case</th><th>Status / due</th><th>Work note</th></tr></thead><tbody>
    @foreach (var item in Model.Cases) { <tr><td><strong>@item.CaseType</strong><code>@item.Rail · @item.Reference · @item.Severity</code><small>@item.Summary</small></td>
        <td>@item.Status<small>@item.AssignedTo · @item.DueDate.ToLocalTime().ToString("MMM d HH:mm")</small></td>
        <td><form asp-action="UpdateCase" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id" /><input name="notes" class="form-control form-control-sm" aria-label="Investigation note" placeholder="Evidence or resolution" /><button class="btn btn-sm btn-outline-secondary" name="resolve" value="false">Assign</button><button class="btn btn-sm btn-outline-primary" name="resolve" value="true">Resolve</button></form></td></tr> }
    </tbody></table></div> }
</section>

<section class="surface operations-panel mt-4" aria-labelledby="trial-heading">
    <div class="eyebrow">UNIFIED SUBLEDGER</div><h2 id="trial-heading" class="h4">Cross-rail trial balance</h2>
    <p class="form-text">Net debit balance by account code, read across the existing wire, ACH, and check journals.</p>
    <div class="row row-cols-1 row-cols-md-3 g-2">@foreach (var account in Model.TrialBalance.OrderBy(x => x.Key)) { <div class="col"><div class="border rounded p-2"><code>@account.Key</code><strong class="float-end">@account.Value.ToString("C")</strong></div></div> }</div>
</section>

<section aria-labelledby="payment-heading" class="mb-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div><div class="eyebrow">PAYMENTS</div><h2 id="payment-heading" class="h4 mb-0">Lifecycle position</h2></div>
        <span class="text-secondary small">@Model.Payments.Total tracked for this persona</span>
    </div>
    <div class="row g-3">
        <div class="col-6 col-lg-3"><div class="ops-kpi kpi-created"><span>Created</span><strong>@Model.Payments.Created</strong><small>Awaiting validation</small></div></div>
        <div class="col-6 col-lg-3"><div class="ops-kpi kpi-pending"><span>Pending</span><strong>@Model.Payments.Pending</strong><small>In rail processing</small></div></div>
        <div class="col-6 col-lg-3"><div class="ops-kpi kpi-settled"><span>Settled</span><strong>@Model.Payments.Settled</strong><small>Final or posted</small></div></div>
        <div class="col-6 col-lg-3"><div class="ops-kpi kpi-rejected"><span>Rejected</span><strong>@Model.Payments.Rejected</strong><small>Returned or failed</small></div></div>
    </div>
</section>

<div class="row g-4 mb-4">
    <section class="col-xl-8" aria-labelledby="queue-heading">
        <div class="surface operations-panel h-100">
            <div class="panel-heading">
                <div><div class="eyebrow">QUEUES</div><h2 id="queue-heading" class="h4 mb-0">Transport depth</h2></div>
                <span class="broker-state @(Model.QueueSnapshot.BrokerAvailable ? "broker-up" : "broker-down")">
                    RabbitMQ @(Model.QueueSnapshot.BrokerAvailable ? "connected" : "unavailable")
                </span>
            </div>
            <div class="queue-groups">
                @foreach (var group in queueGroups)
                {
                    <div class="queue-group">
                        <div class="queue-group-name">@group.Key</div>
                        @foreach (var queue in group)
                        {
                            <div class="queue-row">
                                <code>@queue.Name</code>
                                @if (queue.Exists)
                                {
                                    <span class="queue-consumers">@queue.ConsumerCount consumer@(queue.ConsumerCount == 1 ? "" : "s")</span>
                                    <strong class="queue-depth @(queue.MessageCount > 0 ? "has-messages" : "")">@queue.MessageCount</strong>
                                }
                                else
                                {
                                    <span class="queue-unavailable">Not declared</span><strong class="queue-depth">—</strong>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="col-xl-4" aria-labelledby="rail-heading">
        <div class="surface operations-panel h-100">
            <div class="eyebrow">RAIL STATUS</div>
            <h2 id="rail-heading" class="h4 mb-3">Network health</h2>
            <div class="rail-health-list">
                @foreach (var rail in Model.Rails)
                {
                    <div class="rail-health-row">
                        <span class="health-indicator health-@rail.Status.ToLowerInvariant()"></span>
                        <div><strong>@rail.Rail</strong><small>@rail.Detail</small></div>
                        <span class="health-label health-@rail.Status.ToLowerInvariant()">@rail.Status</span>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<div class="row g-4 mb-4">
    <section class="col-lg-6" aria-labelledby="exception-heading">
        <div class="surface operations-panel h-100">
            <div class="panel-heading">
                <div><div class="eyebrow">EXCEPTIONS</div><h2 id="exception-heading" class="h4 mb-0">Attention required</h2></div>
                <span class="exception-count">@Model.Exceptions.Count recent</span>
            </div>
            @if (Model.Exceptions.Count == 0)
            {
                <div class="operations-empty">No payment exceptions for this persona.</div>
            }
            else
            {
                <div class="exception-list">
                    @foreach (var item in Model.Exceptions)
                    {
                        <div class="exception-row">
                            <span class="exception-mark">!</span>
                            <div><strong>@item.Type</strong><small>@item.Area · @item.Detail</small></div>
                            <div class="text-end"><code>@item.Reference</code><time>@item.OccurredDate.ToLocalTime().ToString("MMM d, HH:mm")</time>
                                <form asp-action="OpenCase" method="post" class="mt-1">
                                    <input type="hidden" name="rail" value="@item.Area" /><input type="hidden" name="caseType" value="@item.Type" />
                                    <input type="hidden" name="reference" value="@item.Reference" /><input type="hidden" name="summary" value="@item.Detail" />
                                    <input type="hidden" name="severity" value="High" /><button class="btn btn-sm btn-outline-secondary" type="submit">Open case</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="settlement-heading">
        <div class="surface operations-panel h-100">
            <div class="panel-heading">
                <div><div class="eyebrow">SETTLEMENT</div><h2 id="settlement-heading" class="h4 mb-0">Master account movement</h2></div>
                <div class="master-balance"><span>Current</span><strong>@Model.Bank.MasterAccountBalance.ToString("C")</strong></div>
            </div>
            @if (Model.SettlementMovements.Count == 0)
            {
                <div class="operations-empty">No settled master account movements yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table operations-table mb-0">
                        <thead><tr><th>Rail / ref</th><th>Counterparty</th><th class="text-end">Movement</th></tr></thead>
                        <tbody>
                        @foreach (var movement in Model.SettlementMovements)
                        {
                            <tr>
                                <td><strong>@movement.Rail</strong><code>@movement.Reference</code></td>
                                <td>@movement.Counterparty<small>@movement.RecordedDate.ToLocalTime().ToString("MMM d, HH:mm")</small></td>
                                <td class="text-end movement @(movement.Amount >= 0 ? "movement-in" : "movement-out")">@(movement.Amount >= 0 ? "+" : "")@movement.Amount.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

<section class="surface operations-panel" aria-labelledby="journal-heading">
    <div class="panel-heading">
        <div><div class="eyebrow">JOURNALS</div><h2 id="journal-heading" class="h4 mb-0">Debit / credit control</h2></div>
        <span class="text-secondary small">Recent journals across all rails</span>
    </div>
    @if (Model.Journals.Count == 0)
    {
        <div class="operations-empty">No journal entries have been posted yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table operations-table mb-0">
                <thead><tr><th>Journal</th><th>Rail</th><th>Entries</th><th class="text-end">Debits</th><th class="text-end">Credits</th><th class="text-end">Control</th></tr></thead>
                <tbody>
                @foreach (var journal in Model.Journals)
                {
                    <tr>
                        <td><code>@journal.JournalId.ToString("N")[..12]</code><small>@journal.CreatedDate.ToLocalTime().ToString("MMM d, HH:mm:ss")</small></td>
                        <td>@journal.Rail</td><td>@journal.EntryCount</td>
                        <td class="text-end">@journal.Debits.ToString("C")</td><td class="text-end">@journal.Credits.ToString("C")</td>
                        <td class="text-end"><span class="journal-control @(journal.IsBalanced ? "is-balanced" : "is-unbalanced")">@(journal.IsBalanced ? "Balanced" : "Out of balance")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="row g-4 mt-1">
    <section class="col-xl-5" aria-labelledby="reconciliation-heading">
        <div class="surface operations-panel h-100">
            <div class="panel-heading">
                <div><div class="eyebrow">RECONCILIATION</div><h2 id="reconciliation-heading" class="h4 mb-0">Durable-state controls</h2></div>
                <span class="journal-control @(Model.Reconciliation.IsClear ? "is-balanced" : "is-unbalanced")">@(Model.Reconciliation.IsClear ? "Clear" : "Review")</span>
            </div>
            <dl class="row mb-0">
                <dt class="col-8">Pending outbox</dt><dd class="col-4 text-end">@Model.Reconciliation.PendingOutboxMessages</dd>
                <dt class="col-8">Incomplete inbox</dt><dd class="col-4 text-end">@Model.Reconciliation.IncompleteInboxMessages</dd>
                <dt class="col-8">Unreplayed dead letters</dt><dd class="col-4 text-end">@Model.Reconciliation.DeadLetterMessages</dd>
                <dt class="col-8">Unbalanced journals</dt><dd class="col-4 text-end">@Model.Reconciliation.UnbalancedJournals</dd>
                <dt class="col-8">Customer hold mismatches</dt><dd class="col-4 text-end">@Model.Reconciliation.HoldMismatches</dd>
                <dt class="col-8">Settled ACH without journals</dt><dd class="col-4 text-end">@Model.Reconciliation.SettledAchWithoutJournals</dd>
                <dt class="col-8">Settled wires without journals</dt><dd class="col-4 text-end">@Model.Reconciliation.SettledWiresWithoutJournals</dd>
            </dl>
            <p class="form-text mt-3 mb-0">Lab control only. It compares payment state, transport records, holds, and journals for the active bank.</p>
        </div>
    </section>
    <section class="col-xl-7" aria-labelledby="recovery-heading">
        <div class="surface operations-panel h-100">
            <div class="eyebrow">RECOVERY</div><h2 id="recovery-heading" class="h4 mb-3">Failed message replay</h2>
            @if (Model.DeadLetters.Count == 0)
            {
                <div class="operations-empty">No unreplayed dead letters owned by this bank.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table operations-table mb-0">
                        <thead><tr><th>Queue</th><th>Failure</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.DeadLetters)
                        {
                            <tr>
                                <td><code>@item.Queue</code><small>@item.Attempts attempts · @item.FailedDate.ToLocalTime().ToString("MMM d, HH:mm")</small></td>
                                <td>@item.Error</td>
                                <td class="text-end"><form asp-action="ReplayDeadLetter" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-primary" type="submit">Replay once</button></form></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.StuckOutbox.Count > 0)
            {
                <h3 class="h6 mt-4">Outbox awaiting publication</h3>
                <ul class="mb-0">
                    @foreach (var item in Model.StuckOutbox)
                    {
                        <li><code>@item.Queue</code> · @item.Attempts attempts · @(item.Error ?? "waiting for publisher")</li>
                    }
                </ul>
            }
        </div>
    </section>
</div>

@section Scripts {
<script>
(() => {
    const refresh = () => window.location.reload();
    document.getElementById('refresh-dashboard')?.addEventListener('click', refresh);
    window.setTimeout(() => { if (!document.hidden) refresh(); }, 15000);
})();
</script>
}
