{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Banking.Web",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Banking.Web/bin/Debug/net10.0/Banking.Web.dll",
      "cwd": "${workspaceFolder}/src/Banking.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5033"
      },
      "console": "internalConsole",
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Banking.AchService",
